# Puerto del servidor HTTP
PORT=3000

# URL base de la API de Tu Descuento
TUDESCUENTO_API_URL=https://api.tudescuento.com

# API Key de Tu Descuento (CRM outbound)
TUDESCUENTO_API_KEY=your_api_key_here

# Configuración del servidor MCP
MCP_SERVER_NAME=tudescuento-mcp-server
MCP_SERVER_VERSION=1.0.0

# Nivel de log (debug, info, warn, error)
LOG_LEVEL=info

# CORS Origins permitidos (separados por comas)
CORS_ORIGINS=http://localhost:5678,https://n8n.tudescuento.com

# ============================================
# AUTENTICACIÓN MCP (REQUERIDO)
# ============================================
# Array JSON de clientes autorizados. Genera tokens con: npm run gen:token -- --name mi-cliente
# Cada token debe tener al menos 32 caracteres.
MCP_AUTH_TOKENS=[{"name":"dev-agent","token":"mcp_live_REPLACE_WITH_npm_run_gen_token_OUTPUT_32chars_min","scopes":["*"]}]

# Rate limit por cliente (requests por minuto). Default: 120
MCP_RATE_LIMIT_PER_MINUTE=120

# Hosts permitidos para DNS rebinding protection (opcional, separados por comas).
# Ejemplo: localhost,127.0.0.1,mcp.tudescuento.com
# Si está vacío, la protección DNS rebinding del transporte queda deshabilitada.
MCP_ALLOWED_HOSTS=

# TTL de sesiones inactivas en ms (default 1800000 = 30 min)
MCP_SESSION_TTL_MS=1800000
