# PRODUCTION ENVIRONMENT CONFIGURATION
# Copiar a .env.production y ajustar valores reales

# Puerto del servidor HTTP
PORT=3000

# URL base de la API de Tu Descuento (PRODUCCIÓN)
TUDESCUENTO_API_URL=https://api.tudescuento.com.co

# API Key de Tu Descuento (USAR CREDENCIALES DE PRODUCCIÓN)
TUDESCUENTO_API_KEY=prod_your_secure_api_key_here

# Tokens Bearer multi-cliente (REQUERIDO). Un token por consumidor del MCP.
# Genera con: npm run gen:token -- --name n8n-support-agent
MCP_AUTH_TOKENS=[{"name":"n8n-support-agent","token":"mcp_live_REPLACE_ME_WITH_SECURE_TOKEN_32chars_min","scopes":["*"]}]

MCP_RATE_LIMIT_PER_MINUTE=120
MCP_ALLOWED_HOSTS=mcp.tudescuento.com.co

# Configuración del servidor MCP
MCP_SERVER_NAME=tudescuento-mcp-server
MCP_SERVER_VERSION=1.0.0

# Nivel de log (usar 'info' o 'warn' en producción, NO 'debug')
LOG_LEVEL=info

# CORS Origins permitidos (ESPECIFICAR DOMINIOS EXACTOS, NO USAR *)
CORS_ORIGINS=https://n8n.tudescuento.com.co,https://app.tudescuento.com.co

# IMPORTANTE PARA PRODUCCIÓN:
# 1. NUNCA usar LOG_LEVEL=debug en producción
# 2. NUNCA usar CORS_ORIGINS=* en producción
# 3. Usar HTTPS para todas las URLs
# 4. Rotar TUDESCUENTO_API_KEY y tokens MCP regularmente
# 5. Emitir un token distinto por cada cliente MCP
# 6. Mantener este archivo fuera del repositorio (.gitignore)
