# ============================================
# VARIABLES DE ENTORNO PARA DOCKER HOST
# ============================================
# Este archivo debe estar en el SERVIDOR/HOST en el mismo directorio que docker-compose.yml
# NO dentro del contenedor Docker (el contenedor recibe las variables desde docker-compose.yml)
#
# IMPORTANTE: Docker Compose lee este archivo .env del HOST y pasa las variables
# al contenedor a través de la sección "environment" en docker-compose.yml
# ============================================

# CÓMO USAR:
# 1. Copiar este archivo a .env:  cp .env.docker.example .env
# 2. Editar .env con valores reales: nano .env
# 3. Ejecutar docker-compose: docker-compose up -d
# 4. Las variables se inyectan al contenedor automáticamente

# ============================================
# VARIABLES REQUERIDAS (OBLIGATORIAS)
# ============================================

# Puerto externo del host (el contenedor siempre usa 3000 internamente)
PORT=3000

# URL base de la API de Tu Descuento (PRODUCCIÓN - REQUERIDO)
TUDESCUENTO_API_URL=https://api.tudescuento.com.co

# API Key de Tu Descuento (PRODUCCIÓN - REQUERIDO)
TUDESCUENTO_API_KEY=your_production_api_key_here

# Tokens Bearer multi-cliente para acceso al MCP (REQUERIDO)
# Genera con: npm run gen:token -- --name n8n-support-agent
# En docker-compose se pasa como string JSON. Escapa comillas si usas shell.
MCP_AUTH_TOKENS=[{"name":"n8n-support-agent","token":"mcp_live_REPLACE_ME_WITH_SECURE_TOKEN_32chars_min","scopes":["*"]}]

# Rate limit por cliente (requests/minuto)
MCP_RATE_LIMIT_PER_MINUTE=120

# Hosts permitidos (DNS rebinding). Ejemplo producción:
# MCP_ALLOWED_HOSTS=mcp.tudescuento.com.co,localhost
MCP_ALLOWED_HOSTS=

# Configuración del servidor MCP (OPCIONALES)
MCP_SERVER_NAME=tudescuento-mcp-server
MCP_SERVER_VERSION=1.0.0

# Nivel de log (info, warn, error - NO usar debug en producción)
LOG_LEVEL=info

# CORS Origins permitidos (IMPORTANTE: Especificar dominios exactos)
CORS_ORIGINS=https://n8n.tudescuento.com.co,https://app.tudescuento.com.co

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. Este archivo .env es para el HOST (servidor), no el contenedor
# 2. NUNCA subir este archivo a Git (ya está en .gitignore)
# 3. TUDESCUENTO_API_URL, TUDESCUENTO_API_KEY y MCP_AUTH_TOKENS son OBLIGATORIAS
# 4. Rota tokens MCP periódicamente y emite uno por cada cliente consumidor
